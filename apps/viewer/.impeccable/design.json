  "components": [
    {
      "name": "Button Primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared action control.",
      "html": "<button class=\"ds-button-primary\">Inspect call</button>",
      "css": ".ds-button-primary{font-family:var(--font-family-sans);font-size:var(--font-size-sm);font-weight:500;border-radius:var(--shape-radius-md);min-height:2rem;padding:0 0.75rem;cursor:pointer;color:var(--color-on-action);background:var(--color-action);border:none;} .ds-button-primary:hover{background:var(--color-action-hover);} .ds-button-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-app-bg),0 0 0 4px var(--color-focus-ring);} .ds-button-primary:disabled{opacity:0.5;cursor:default;} @media(max-width:40rem){.ds-button-primary{min-height:2.75rem;}}"
    },
    {
      "name": "Button Outline",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shared action control.",
      "html": "<button class=\"ds-button-outline\">Inspect call</button>",
      "css": ".ds-button-outline{font-family:var(--font-family-sans);font-size:var(--font-size-sm);font-weight:500;border-radius:var(--shape-radius-md);min-height:2rem;padding:0 0.75rem;cursor:pointer;color:var(--color-text-secondary);background:var(--color-bg-surface);border:1px solid var(--color-stroke);} .ds-button-outline:hover{background:var(--color-bg-surface-secondary);border-color:var(--color-stroke-strong);color:var(--color-text-primary);} .ds-button-outline:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-app-bg),0 0 0 4px var(--color-focus-ring);} .ds-button-outline:disabled{opacity:0.5;cursor:default;} @media(max-width:40rem){.ds-button-outline{min-height:2.75rem;}}"
    },
