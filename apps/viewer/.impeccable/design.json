      "description": "Quiet underline harness selection.",
      "html": "<div class=\"ds-scope\" role=\"group\" aria-label=\"Filter by harness\"><button type=\"button\" aria-pressed=\"true\">All</button><button type=\"button\" aria-pressed=\"false\">Codex</button><button type=\"button\" aria-pressed=\"false\">OpenCode</button></div>",
      "css": ".ds-scope{display:flex;gap:1rem;font-family:var(--font-family-sans);}.ds-scope button{min-height:2rem;padding:0 0.25rem 0.5rem;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--color-text-muted);font-family:var(--font-family-sans);font-size:var(--font-size-sm);font-weight:500;cursor:pointer;}.ds-scope button:hover{background:var(--color-scope-hover);}.ds-scope button[aria-pressed=true]{color:var(--color-text-primary);border-color:var(--color-action);}.ds-scope button:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}@media(max-width:40rem){.ds-scope button{flex:1;min-height:2.75rem;}}"
    },
