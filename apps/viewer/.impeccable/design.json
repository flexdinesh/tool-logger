      "name": "Native status labels",
      "kind": "chip",
      "refersTo": "status-neutral",
      "description": "Observed results remain neutral; awaiting and native outcomes use semantic variants.",
      "html": "<div class=\"ds-status-list\"><span class=\"ds-status ds-status-neutral\"><span class=\"ds-status-marker\" aria-hidden=\"true\"></span>Result received</span><span class=\"ds-status ds-status-success\"><span class=\"ds-status-marker\" aria-hidden=\"true\"></span>Succeeded</span><span class=\"ds-status ds-status-warning\"><span class=\"ds-status-marker\" aria-hidden=\"true\"></span>Awaiting result</span><span class=\"ds-status ds-status-destructive\"><span class=\"ds-status-marker\" aria-hidden=\"true\"></span>Failed</span></div>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:0.375rem;padding:0.25rem 0.5rem;font-family:var(--font-family-sans);font-size:var(--font-size-xs);font-weight:500;border:1px solid var(--color-stroke);border-radius:var(--shape-radius-sm);background:var(--color-bg-surface-secondary);color:var(--color-text-secondary);} .ds-status-marker{width:0.375rem;height:0.375rem;border-radius:50%;background:currentColor;}.ds-status-list{display:flex;flex-wrap:wrap;gap:0.5rem;}.ds-status-success{color:var(--color-state-success);background:var(--color-state-success-soft);border-color:color-mix(in srgb,var(--color-state-success) 20%,transparent);}.ds-status-warning{color:var(--color-state-warning);background:var(--color-state-warning-soft);border-color:color-mix(in srgb,var(--color-state-warning) 20%,transparent);}.ds-status-destructive{color:var(--color-state-destructive);background:var(--color-state-destructive-soft);border-color:color-mix(in srgb,var(--color-state-destructive) 20%,transparent);}"
    },
    {
      "name": "Content surface",
      "kind": "card",
      "refersTo": "content-surface",
      "description": "Shared flat bordered primitive; dashboard sections stay edge to edge.",
      "html": "<section class=\"ds-surface\"><h2>Recent calls</h2><p>Inspect local tool evidence.</p></section>",
      "css": ".ds-surface{padding:var(--space-4);font-family:var(--font-family-sans);color:var(--color-text-primary);background:var(--color-bg-surface);border:1px solid var(--color-stroke);border-radius:var(--shape-radius-lg);} .ds-surface h2{margin:0;font-size:var(--font-size-sm);font-weight:600;} .ds-surface p{margin:var(--space-2) 0 0;font-size:var(--font-size-sm);color:var(--color-text-muted);}"
    },
    {
      "name": "Payload panel",
      "kind": "custom",
      "refersTo": "payload",
      "description": "Ruled tabs and scrollable native JSON; static state illustration.",
      "html": "<section class=\"ds-payload\"><div class=\"ds-payload-tabs\" role=\"tablist\" aria-label=\"Call payload\"><button role=\"tab\" aria-selected=\"true\">Input</button><button role=\"tab\" aria-selected=\"false\">Result</button><button role=\"tab\" aria-selected=\"false\">Raw events</button></div><pre class=\"ds-payload-code\" tabindex=\"0\">{\n  \"command\": \"pnpm check\"\n}</pre></section>",
      "css": ".ds-payload{font-family:var(--font-family-sans);}.ds-payload-tabs{display:flex;gap:1.5rem;border-bottom:1px solid var(--color-stroke);}.ds-payload-tabs button{padding:0.5rem 0;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--color-text-muted);font-family:var(--font-family-sans);font-size:var(--font-size-sm);font-weight:500;cursor:pointer;}.ds-payload-tabs button:hover{color:var(--color-text-secondary);}.ds-payload-tabs button[aria-selected=true]{color:var(--color-action);border-color:var(--color-action);}.ds-payload-tabs button:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}.ds-payload-code{max-height:58vh;overflow:auto;padding:0.75rem;border:1px solid var(--color-stroke);border-radius:var(--shape-radius-md);background:var(--color-bg-surface-secondary);color:var(--color-text-secondary);font-family:var(--font-family-mono);font-size:var(--font-size-xs);line-height:2;white-space:pre-wrap;overflow-wrap:break-word;tab-size:2;}.ds-payload-code:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}@media(max-width:40rem){.ds-payload-tabs button{min-height:2.75rem;min-width:2.75rem;}}"
    },
    {
      "name": "Right inspector",
      "kind": "custom",
      "refersTo": "inspector",
      "description": "Flat desktop evidence pane; Radix/application code supplies adaptive modal behavior.",
      "html": "<aside class=\"ds-inspector\" aria-label=\"Tool call details\"><div class=\"ds-inspector-heading\"><h2>exec_command</h2><button aria-label=\"Close call details\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div><dl class=\"ds-inspector-meta\"><dt>Harness</dt><dd>Codex</dd><dt>Duration</dt><dd>142 ms</dd></dl><pre class=\"ds-inspector-code\">{ \"command\": \"pnpm check\" }</pre></aside>",
      "css": ".ds-inspector{width:clamp(24rem,32vw,30rem);max-width:100%;padding:1rem;border-left:1px solid var(--color-stroke);background:var(--color-bg-surface);color:var(--color-text-primary);font-family:var(--font-family-sans);}.ds-inspector-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;}.ds-inspector-heading h2{margin:0;font-size:var(--font-size-xl);font-weight:600;letter-spacing:-0.025em;}.ds-inspector-heading button{width:2rem;height:2rem;padding:0;border:0;border-radius:var(--shape-radius-md);background:transparent;color:var(--color-action);cursor:pointer;}.ds-inspector-heading svg{width:1rem;height:1rem;}.ds-inspector-heading button:hover{background:var(--color-action-soft);color:var(--color-action-hover);}.ds-inspector-heading button:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}.ds-inspector-meta{display:grid;grid-template-columns:72px minmax(0,1fr);gap:0.5rem;padding:0.75rem 0;border-top:1px solid var(--color-stroke);border-bottom:1px solid var(--color-stroke);font-size:var(--font-size-xs);}.ds-inspector-meta dt{color:var(--color-text-muted);}.ds-inspector-meta dd{margin:0;color:var(--color-text-secondary);font-variant-numeric:tabular-nums;}.ds-inspector-code{padding:0.75rem;border:1px solid var(--color-stroke);border-radius:var(--shape-radius-md);background:var(--color-bg-surface-secondary);color:var(--color-text-secondary);font-family:var(--font-family-mono);font-size:var(--font-size-xs);line-height:2;white-space:pre-wrap;overflow-wrap:break-word;}@media(max-width:40rem){.ds-inspector{width:100%;}.ds-inspector-heading button{width:2.75rem;height:2.75rem;}}"
    }
  ],
  "narrative": {
    "northStar": "Graphite",
    "overview": "Graphite is a compact, precise workspace for reading local tool evidence. Charcoal and near-white surfaces, slate text, thin rules, and restrained green accents keep dense information calm and readable. Shared React, Tailwind, and shadcn/ui primitives maintain consistent controls and states.\n\nBoth themes use the same semantic roles. Tone and borders establish depth; short motion explains state changes. Native evidence remains readable text. Page strategy and composition stay in the viewer surface contract.",
    "keyCharacteristics": [
      "Compact controls",
      "Thin neutral rules",
      "Paired light and dark palettes",
      "Readable native evidence"
    ],
    "rules": [
      {
        "name": "Native Outcomes",
        "body": "Result presence stays neutral; use success or failure colors only for a reported outcome.",
        "section": "colors"
      },
      {
        "name": "Shared Scale",
        "body": "Use shared rem type roles and the 4px spacing rhythm; use monospace for evidence.",
        "section": "typography"
      },
      {
        "name": "Structural Depth",
        "body": "Keep content flat; reserve the overlay shadow and scrim for the modal inspector.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic variables and shared components in both themes.",
      "Do pair chart and state colors with readable labels and visible keyboard focus.",
      "Do preserve native outcomes, identifiers, and payload text.",
      "Do reflow data for phones and respect reduced motion."
    ],
    "donts": [
      "Don't infer tool success from result presence.",
      "Don't add oversized color fields, floating dashboard frames, or decorative effects that compete with calls.",
      "Don't hard-code theme colors in shared components.",
      "Don't carry unused navigation or live-glow compatibility tokens into new surfaces."
    ]
  }
}
